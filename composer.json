{
    "name": "sanwohq/laravel",
    "description": "Sanwo payment SDK for Laravel — Blade components for Paystack, Flutterwave, Razorpay, Monnify, Interswitch, and custom providers.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["laravel", "payments", "paystack", "flutterwave", "razorpay", "monnify", "interswitch", "sanwo"],
    "homepage": "https://sanwohq.com",
    "authors": [
        {
            "name": "SanwoHQ",
            "email": "hello@sanwohq.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sanwo\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sanwo\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sanwo\\Laravel\\SanwoServiceProvider"
            ],
            "aliases": {
                "Sanwo": "Sanwo\\Laravel\\Facades\\Sanwo"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
